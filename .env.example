# Copy this file to .env and fill in real values before running deploy.sh.
# Never commit a filled-in .env.

# --- Claude Code auth: set exactly ONE of these two ---
# Pro/Max subscription: generate on a machine you already log into Claude Code
# on, via `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# Anthropic Console API billing instead of a subscription:
ANTHROPIC_API_KEY=

# --- Telegram ---
# From @BotFather on Telegram after /newbot
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user id (used to pre-seed the access allowlist
# after pairing; find it via @userinfobot). Optional — you can pair
# interactively instead, see README.
TELEGRAM_OWNER_USER_ID=

# --- Yandex.Disk (REST API route) ---
# OAuth token from https://oauth.yandex.ru/ for an app with disk scopes.
# Leave blank if you're using the yandex-disk daemon route instead.
YANDEX_DISK_TOKEN=

# Folder on Yandex.Disk to sync the workspace notes with, e.g. /ai-assistant
YANDEX_DISK_REMOTE_PATH=/ai-assistant

# --- Workspace ---
# Where the assistant's working directory lives on this server.
ASSISTANT_HOME=/opt/ai-assistant
