# Copied to secrets/.env by install.sh (from the prompts you answer, or
# blank if you skipped them). Fill in blanks manually later if needed —
# nothing here is committed to git.

# --- Claude Code auth ---
# Not set here: run `claude /login` yourself the first time you attach to
# tmux and start the assistant.

# --- Telegram ---
# From @BotFather on Telegram after /newbot
TELEGRAM_BOT_TOKEN=

# --- Yandex.Disk (REST API route) ---
# OAuth token from https://oauth.yandex.ru/ for an app with disk scopes.
YANDEX_DISK_TOKEN=

# Folder on Yandex.Disk that shared-files/ syncs with, e.g. /ai-assistant
YANDEX_DISK_REMOTE_PATH=/ai-assistant

# --- Google Calendar (OAuth device flow) ---
# Client ID/secret from a Google Cloud Console OAuth Client (type "TVs and
# Limited Input devices"), with the Calendar API enabled on that project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Filled in by tools/google-calendar/auth.sh after the one-time device-flow
# authorization — leave blank until you've run it.
GOOGLE_CALENDAR_REFRESH_TOKEN=
