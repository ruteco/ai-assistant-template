[Unit]
Description=Personal Claude Code assistant (Telegram channel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__ASSISTANT_USER__
WorkingDirectory=__ASSISTANT_HOME__
EnvironmentFile=__ASSISTANT_HOME__/.env
ExecStart=__CLAUDE_BIN__ --channels plugin:telegram@claude-plugins-official
Restart=always
RestartSec=5
StandardOutput=append:__ASSISTANT_HOME__/assistant.log
StandardError=append:__ASSISTANT_HOME__/assistant.log

[Install]
WantedBy=multi-user.target
